PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/foodiq
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=change-this-in-production
JWT_EXPIRES_IN=7d
AI_SERVICE_URL=http://127.0.0.1:8001
CLIENT_URL=http://localhost:5173
# Payment: leave blank to run in mock mode (orders auto-marked paid)
# RAZORPAY_KEY_ID=rzp_test_xxxx
# RAZORPAY_KEY_SECRET=xxxx
# Push notifications (FCM): leave blank to run in mock mode (logged, not sent)
# FIREBASE_SERVICE_ACCOUNT=C:/path/to/foodiq-firebase-adminsdk.json
